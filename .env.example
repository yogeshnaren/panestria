# Synthetic placeholders only. Panestria does not load this file.
# Export these names into the process environment. The password below is an
# accepted synthetic value; health output must not print it. No live database
# probe runs in this slice, so exporting this file does not open PostgreSQL.
PANESTRIA_SCHEMA_VERSION=1
PANESTRIA_PROFILE=SYNTHETIC_DEV
PANESTRIA_BIND_HOST=127.0.0.1
PANESTRIA_BIND_PORT=8765
PANESTRIA_READINESS_BUDGET_MS=500
PANESTRIA_DATABASE_URL=postgresql://panestria_synthetic:placeholder-not-a-secret@127.0.0.1:5432/panestria_synthetic
