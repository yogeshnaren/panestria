{
  "components": {
    "schemas": {
      "DependencyCheck": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "database",
              "executor"
            ],
            "title": "Name",
            "type": "string"
          },
          "reason": {
            "enum": [
              "capacity_unknown",
              "database_unavailable",
              "deadline_exceeded",
              "not_implemented",
              "not_probed",
              "probe_busy",
              "probe_failed",
              "ready"
            ],
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "unavailable",
              "degraded",
              "not_configured"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "reason"
        ],
        "title": "DependencyCheck",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": "secret_bearing_output_rejected",
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Correlation Id",
            "type": "string"
          },
          "message": {
            "const": "response rejected because it contained configured secret material",
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "const": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id",
          "retryable"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Liveness": {
        "additionalProperties": false,
        "properties": {
          "profile": {
            "const": "SYNTHETIC_DEV",
            "title": "Profile",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "const": "live",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "status",
          "version",
          "profile"
        ],
        "title": "Liveness",
        "type": "object"
      },
      "Readiness": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/DependencyCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "status",
          "checks"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "panestria",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
