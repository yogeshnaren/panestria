{
  "components": {
    "schemas": {
      "ActivityEntry": {
        "additionalProperties": false,
        "properties": {
          "active_tasks": {
            "minimum": 0.0,
            "title": "Active Tasks",
            "type": "integer"
          },
          "canonical_state": {
            "pattern": "^[A-Z_]{1,32}$",
            "title": "Canonical State",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "held_build_claims": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Held Build Claims"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "needs_attention": {
            "title": "Needs Attention",
            "type": "boolean"
          },
          "source": {
            "enum": [
              "ASK",
              "GOAL"
            ],
            "title": "Source",
            "type": "string"
          },
          "waiting_reviews": {
            "minimum": 0.0,
            "title": "Waiting Reviews",
            "type": "integer"
          },
          "workflow": {
            "enum": [
              "ASK",
              "DELEGATE",
              "BUILD",
              "KERNEL"
            ],
            "title": "Workflow",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source",
          "workflow",
          "canonical_state",
          "created_at",
          "active_tasks",
          "waiting_reviews",
          "needs_attention"
        ],
        "title": "ActivityEntry",
        "type": "object"
      },
      "ApprovalList": {
        "additionalProperties": false,
        "properties": {
          "approvals": {
            "items": {
              "$ref": "#/components/schemas/PendingApproval"
            },
            "title": "Approvals",
            "type": "array"
          }
        },
        "required": [
          "approvals"
        ],
        "title": "ApprovalList",
        "type": "object"
      },
      "ApprovalPreviewBody": {
        "additionalProperties": false,
        "properties": {
          "approval_id": {
            "title": "Approval Id",
            "type": "string"
          },
          "continuation_kind": {
            "minLength": 1,
            "title": "Continuation Kind",
            "type": "string"
          },
          "effect_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Effect Digest",
            "type": "string"
          },
          "expected_version": {
            "minimum": 0.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "preview": {
            "additionalProperties": true,
            "title": "Preview",
            "type": "object"
          },
          "state": {
            "minLength": 1,
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "approval_id",
          "effect_digest",
          "expected_version",
          "state",
          "continuation_kind",
          "preview"
        ],
        "title": "ApprovalPreviewBody",
        "type": "object"
      },
      "ArtifactBody": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "title": "Artifact Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0.0,
            "title": "Size Bytes",
            "type": "integer"
          },
          "verdicts": {
            "items": {
              "$ref": "#/components/schemas/ArtifactVerdict"
            },
            "title": "Verdicts",
            "type": "array"
          }
        },
        "required": [
          "artifact_id",
          "kind",
          "sha256",
          "size_bytes",
          "verdicts"
        ],
        "title": "ArtifactBody",
        "type": "object"
      },
      "ArtifactVerdict": {
        "additionalProperties": false,
        "properties": {
          "check_key": {
            "title": "Check Key",
            "type": "string"
          },
          "verdict": {
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "check_key",
          "verdict"
        ],
        "title": "ArtifactVerdict",
        "type": "object"
      },
      "CancelResult": {
        "additionalProperties": false,
        "properties": {
          "goal_id": {
            "title": "Goal Id",
            "type": "string"
          },
          "goal_status": {
            "minLength": 1,
            "title": "Goal Status",
            "type": "string"
          },
          "task_state": {
            "minLength": 1,
            "title": "Task State",
            "type": "string"
          },
          "task_version": {
            "minimum": 0.0,
            "title": "Task Version",
            "type": "integer"
          }
        },
        "required": [
          "goal_id",
          "goal_status",
          "task_state",
          "task_version"
        ],
        "title": "CancelResult",
        "type": "object"
      },
      "DecisionReceipt": {
        "additionalProperties": false,
        "properties": {
          "approval_id": {
            "title": "Approval Id",
            "type": "string"
          },
          "effect_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Effect Digest",
            "type": "string"
          },
          "replayed": {
            "title": "Replayed",
            "type": "boolean"
          },
          "row_version": {
            "minimum": 0.0,
            "title": "Row Version",
            "type": "integer"
          },
          "state": {
            "minLength": 1,
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "approval_id",
          "state",
          "effect_digest",
          "row_version",
          "replayed"
        ],
        "title": "DecisionReceipt",
        "type": "object"
      },
      "DependencyCheck": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "database",
              "executor"
            ],
            "title": "Name",
            "type": "string"
          },
          "reason": {
            "enum": [
              "capacity_unknown",
              "database_unavailable",
              "deadline_exceeded",
              "not_implemented",
              "not_probed",
              "probe_busy",
              "probe_failed",
              "ready"
            ],
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "unavailable",
              "degraded",
              "not_configured"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "reason"
        ],
        "title": "DependencyCheck",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "const": "secret_bearing_output_rejected",
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "Correlation Id",
            "type": "string"
          },
          "message": {
            "const": "response rejected because it contained configured secret material",
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "const": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id",
          "retryable"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "EventPage": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventRow"
            },
            "title": "Events",
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "title": "EventPage",
        "type": "object"
      },
      "EventRow": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "minLength": 1,
            "title": "Kind",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "seq": {
            "pattern": "^[0-9]+$",
            "title": "Seq",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "kind",
          "payload"
        ],
        "title": "EventRow",
        "type": "object"
      },
      "GoalStatus": {
        "additionalProperties": false,
        "properties": {
          "goal_id": {
            "title": "Goal Id",
            "type": "string"
          },
          "status": {
            "minLength": 1,
            "title": "Status",
            "type": "string"
          },
          "task_version": {
            "minimum": 0.0,
            "title": "Task Version",
            "type": "integer"
          }
        },
        "required": [
          "goal_id",
          "status",
          "task_version"
        ],
        "title": "GoalStatus",
        "type": "object"
      },
      "GoalSubmission": {
        "additionalProperties": false,
        "properties": {
          "contract_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Contract Sha256",
            "type": "string"
          },
          "contract_version": {
            "minimum": 1.0,
            "title": "Contract Version",
            "type": "integer"
          },
          "goal_id": {
            "title": "Goal Id",
            "type": "string"
          },
          "replayed": {
            "title": "Replayed",
            "type": "boolean"
          }
        },
        "required": [
          "goal_id",
          "contract_version",
          "contract_sha256",
          "replayed"
        ],
        "title": "GoalSubmission",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Liveness": {
        "additionalProperties": false,
        "properties": {
          "profile": {
            "const": "SYNTHETIC_DEV",
            "title": "Profile",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "const": "live",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "status",
          "version",
          "profile"
        ],
        "title": "Liveness",
        "type": "object"
      },
      "PendingApproval": {
        "additionalProperties": false,
        "properties": {
          "action_kind": {
            "minLength": 1,
            "title": "Action Kind",
            "type": "string"
          },
          "approval_id": {
            "title": "Approval Id",
            "type": "string"
          },
          "effect_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Effect Digest",
            "type": "string"
          },
          "expected_version": {
            "minimum": 0.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "expires_at": {
            "minLength": 1,
            "title": "Expires At",
            "type": "string"
          },
          "goal_id": {
            "title": "Goal Id",
            "type": "string"
          }
        },
        "required": [
          "approval_id",
          "goal_id",
          "effect_digest",
          "action_kind",
          "expected_version",
          "expires_at"
        ],
        "title": "PendingApproval",
        "type": "object"
      },
      "ProjectActivity": {
        "additionalProperties": false,
        "properties": {
          "acceptance_authority": {
            "const": "NONE",
            "default": "NONE",
            "title": "Acceptance Authority",
            "type": "string"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/ActivityEntry"
            },
            "maxItems": 32,
            "title": "Entries",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "maxLength": 41,
                "pattern": "^(ASK|GOAL):[0-9a-f-]{36}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "owner_id": {
            "format": "uuid",
            "title": "Owner Id",
            "type": "string"
          },
          "project_id": {
            "format": "uuid",
            "title": "Project Id",
            "type": "string"
          },
          "view_authority": {
            "const": "READ_ONLY_METADATA",
            "default": "READ_ONLY_METADATA",
            "title": "View Authority",
            "type": "string"
          }
        },
        "required": [
          "owner_id",
          "project_id",
          "observed_at",
          "entries"
        ],
        "title": "ProjectActivity",
        "type": "object"
      },
      "Readiness": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/DependencyCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "status",
          "checks"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "panestria",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz"
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readyz"
      }
    },
    "/v1/activity": {
      "get": {
        "operationId": "activity_v1_activity_get",
        "parameters": [
          {
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 41,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Before"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 16,
              "maximum": 32,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectActivity"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Activity"
      }
    },
