{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persisted TaskEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "seq",
    "goal_id",
    "task_id",
    "attempt_id",
    "kind",
    "occurred_at",
    "actor",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "seq": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "goal_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    }
  }
}
